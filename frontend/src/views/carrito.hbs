<div class="page-header">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2" style="font-size:0.85rem; opacity:0.6;">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color:inherit;">Inicio</a></li>
        <li class="breadcrumb-item active">Carrito</li>
      </ol>
    </nav>
    <h1 class="section-title mb-1">Mi Carrito</h1>
    <p class="section-subtitle">Revisá tu pedido antes de confirmar</p>
  </div>
</div>

<section class="section-pad-sm">
  <div class="container">

    <!-- CARRITO VACÍO -->
    <div id="carritoVacio" class="cart-empty d-none">
      <i class="bi bi-bag-x"></i>
      <h4 style="font-family:'Rajdhani',sans-serif; font-weight:700;">Tu carrito está vacío</h4>
      <p class="mb-4">Aún no agregaste ningún producto.</p>
      <a href="/productos" class="btn btn-accent px-4">
        <i class="bi bi-grid me-2"></i>Ver productos
      </a>
    </div>

  
    <div id="carritoConItems">
      <div class="row g-4">
        
        <div class="col-lg-8">
          <div id="listaItems"></div>
          <div class="d-flex justify-content-between mt-3">
            <a href="/productos" class="btn btn-outline-light btn-sm px-3">
              <i class="bi bi-arrow-left me-2"></i>Seguir comprando
            </a>
            <button class="btn btn-sm px-3" style="border: 1px solid rgba(239,68,68,0.3); color: var(--ts-danger); background:transparent; border-radius:8px;"
              onclick="vaciarCarrito()">
              <i class="bi bi-trash me-2"></i>Vaciar carrito
            </button>
          </div>
        </div>

        
        <div class="col-lg-4">
          <div class="order-summary">
            <div class="summary-title">Resumen del pedido</div>
            <div class="summary-row">
              <span>Subtotal</span>
              <span id="summarySubtotal">$0</span>
            </div>
            <div class="summary-row">
              <span>Envío</span>
              <span class="text-accent">Gratis</span>
            </div>
            <div class="summary-row total">
              <span>Total</span>
              <span id="summaryTotal">$0</span>
            </div>

            <button class="btn-checkout" id="btnCheckout" onclick="enviarPedido()">
              <i class="bi bi-lock-fill me-2"></i>Confirmar pedido
            </button>

            <div class="text-center mt-3">
              <small style="color: var(--ts-muted); font-size: 0.78rem;">
                <i class="bi bi-shield-check me-1 text-success"></i>
                Compra 100% segura y encriptada
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<div class="toast-container" id="toastContainer"></div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  renderCarrito();
});

function renderCarrito() {
  const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
  const listaItems = document.getElementById('listaItems');
  const carritoVacio = document.getElementById('carritoVacio');
  const carritoConItems = document.getElementById('carritoConItems');

  if (carrito.length === 0) {
    carritoVacio.classList.remove('d-none');
    carritoConItems.classList.add('d-none');
    return;
  }

  carritoVacio.classList.add('d-none');
  carritoConItems.classList.remove('d-none');

  listaItems.innerHTML = carrito.map((item, i) => `
    <div class="cart-item">
      <img src="${item.imagen || 'https://via.placeholder.com/80'}" alt="${item.nombre}" class="cart-item-img" />
      <div class="flex-grow-1">
        <div class="cart-item-name">${item.nombre}</div>
        <div style="font-size:0.8rem; color: var(--ts-muted);">${item.categoria || 'General'}</div>
        <div class="cart-item-price mt-1">$${item.precio.toLocaleString('es-AR')}</div>
      </div>
      <div class="qty-control">
        <button class="qty-btn" onclick="cambiarCantidad(${i}, -1)"><i class="bi bi-dash"></i></button>
        <span class="qty-value">${item.cantidad}</span>
        <button class="qty-btn" onclick="cambiarCantidad(${i}, 1)"><i class="bi bi-plus"></i></button>
      </div>
      <div style="color: var(--ts-muted); font-size:0.9rem; min-width:90px; text-align:right;">
        $${(item.precio * item.cantidad).toLocaleString('es-AR')}
      </div>
      <button class="btn-remove" onclick="eliminarItem(${i})"><i class="bi bi-trash3"></i></button>
    </div>
  `).join('');

  const total = carrito.reduce((acc, item) => acc + item.precio * item.cantidad, 0);
  document.getElementById('summarySubtotal').textContent = '$' + total.toLocaleString('es-AR');
  document.getElementById('summaryTotal').textContent = '$' + total.toLocaleString('es-AR');
}

function cambiarCantidad(index, delta) {
  const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
  carrito[index].cantidad += delta;
  if (carrito[index].cantidad <= 0) carrito.splice(index, 1);
  localStorage.setItem('carrito', JSON.stringify(carrito));
  actualizarBadge();
  renderCarrito();
}

function eliminarItem(index) {
  const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
  carrito.splice(index, 1);
  localStorage.setItem('carrito', JSON.stringify(carrito));
  actualizarBadge();
  renderCarrito();
}

function vaciarCarrito() {
  localStorage.removeItem('carrito');
  actualizarBadge();
  renderCarrito();
}

async function enviarPedido() {
  const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
  if (carrito.length === 0) return;

  const btn = document.getElementById('btnCheckout');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

  const total = carrito.reduce((acc, item) => acc + item.precio * item.cantidad, 0);

  try {
    const res = await fetch('http://localhost:3000/api/carrito', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: carrito, total })
    });

    if (res.ok) {
      localStorage.removeItem('carrito');
      actualizarBadge();
      mostrarToast('✅ ¡Pedido confirmado! Gracias por tu compra.');
      setTimeout(() => window.location.href = '/success', 2000);
    } else {
      throw new Error('Error del servidor');
    }
  } catch (e) {
    mostrarToast('❌ Error al procesar el pedido. Intentá de nuevo.', 'error');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-lock-fill me-2"></i>Confirmar pedido';
  }
}

function mostrarToast(msg, tipo = 'success') {
  const container = document.getElementById('toastContainer');
  const toast = document.createElement('div');
  toast.className = 'ts-toast';
  toast.style.borderColor = tipo === 'error' ? 'rgba(239,68,68,0.3)' : 'rgba(0,212,255,0.3)';
  toast.innerHTML = `<i class="bi bi-${tipo === 'error' ? 'x-circle text-danger' : 'check-circle text-success'}"></i><span>${msg}</span>`;
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 4000);
}
</script>
