<!-- HERO -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <div class="hero-badge">
          <i class="bi bi-lightning-charge-fill"></i>
          Nuevos productos disponibles
        </div>
        <h1 class="hero-title">
          Tecnología que<br>
          <span class="highlight">transforma</span><br>
          tu mundo
        </h1>
        <p class="hero-desc">
          Encontrá los mejores productos tech con garantía oficial, envío rápido y los precios más competitivos del mercado.
        </p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/productos" class="btn btn-accent btn-lg px-4">
            <i class="bi bi-grid me-2"></i>Ver productos
          </a>
          <a href="#destacados" class="btn btn-outline-light btn-lg px-4">
            Destacados <i class="bi bi-arrow-down ms-2"></i>
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-number">500+</div>
            <div class="stat-label">Productos</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">12k+</div>
            <div class="stat-label">Clientes</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">4.9★</div>
            <div class="stat-label">Valoración</div>
          </div>
        </div>
      </div>
      <div class="col-lg-6 text-center">
        <div class="hero-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1593640495253-23196b27a87f?w=600&q=80"
            alt="Tecnología"
            class="hero-img"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES STRIP -->
<div class="features-strip">
  <div class="container">
    <div class="row gy-3">
      <div class="col-sm-6 col-lg-3">
        <div class="feature-item">
          <i class="bi bi-truck"></i>
          Envío gratis desde $50.000
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="feature-item">
          <i class="bi bi-shield-check"></i>
          Garantía oficial
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="feature-item">
          <i class="bi bi-arrow-counterclockwise"></i>
          30 días de devolución
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="feature-item">
          <i class="bi bi-headset"></i>
          Soporte 24/7
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PRODUCTOS DESTACADOS -->
<section class="section-pad" id="destacados">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5">
      <div>
        <h2 class="section-title">Productos destacados</h2>
        <p class="section-subtitle mt-2">Lo más vendido de esta semana</p>
      </div>
      <a href="/productos" class="btn btn-outline-light btn-sm px-3 d-none d-md-inline-flex">
        Ver todos <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>

    <div class="row g-4" id="productosDestacados">
      <!-- Los productos se cargan dinámicamente desde el backend -->
      <div class="col-12 text-center py-5 text-muted" id="loadingDestacados">
        <div class="spinner-border spinner-border-sm me-2" style="color: var(--ts-accent)"></div>
        Cargando productos...
      </div>
    </div>

    <div class="text-center mt-4 d-md-none">
      <a href="/productos" class="btn btn-outline-light px-4">Ver todos los productos</a>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="section-pad-sm" style="background: var(--ts-surface); border-top: 1px solid var(--ts-border); border-bottom: 1px solid var(--ts-border);">
  <div class="container text-center">
    <h2 class="section-title mx-auto" style="display:block;">¿Buscás algo específico?</h2>
    <p class="section-subtitle mt-2 mb-4">Explorá nuestro catálogo completo con filtros por categoría y precio</p>
    <a href="/productos" class="btn btn-accent btn-lg px-5">
      <i class="bi bi-search me-2"></i>Explorar catálogo
    </a>
  </div>
</section>

<script>
// Cargar productos destacados desde el backend
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('http://localhost:3000/api/productos');
    const productos = await res.json();
    const container = document.getElementById('productosDestacados');
    const loading = document.getElementById('loadingDestacados');

    if (productos.length === 0) {
      loading.innerHTML = '<p class="text-muted">No hay productos disponibles aún.</p>';
      return;
    }

    loading.remove();
    // Mostrar máximo 4 destacados
    productos.slice(0, 4).forEach(p => {
      container.innerHTML += `
        <div class="col-sm-6 col-lg-3">
          <div class="product-card">
            <div class="product-img-wrap">
              <img src="${p.imagen || 'https://via.placeholder.com/300x200?text=Sin+imagen'}" alt="${p.nombre}" />
              <span class="product-badge">Nuevo</span>
            </div>
            <div class="product-body">
              <div class="product-category">${p.categoria || 'General'}</div>
              <div class="product-name">${p.nombre}</div>
              <div class="product-desc">${p.descripcion || ''}</div>
              <div class="product-price"><span class="currency">$</span>${p.precio.toLocaleString('es-AR')}</div>
              <button class="btn-add-cart" onclick="agregarAlCarrito(${JSON.stringify(p).replace(/"/g, '&quot;')})">
                <i class="bi bi-bag-plus me-2"></i>Agregar al carrito
              </button>
            </div>
          </div>
        </div>`;
    });
  } catch (e) {
    document.getElementById('loadingDestacados').innerHTML =
      '<p class="text-muted">No se pudo conectar con el servidor.</p>';
  }
});
</script>
